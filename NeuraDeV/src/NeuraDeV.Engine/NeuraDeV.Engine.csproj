<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NeuraDeV.Engine</RootNamespace>
    <AssemblyName>NeuraDeV.Engine</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Add to enable real local LLM inference (GGUF models, llama.cpp):
    <PackageReference Include="LLamaSharp" Version="0.19.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.19.0" />
       (or LLamaSharp.Backend.Cuda12 for NVIDIA GPU)

    Add to enable real C# static analysis:
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  -->

</Project>
