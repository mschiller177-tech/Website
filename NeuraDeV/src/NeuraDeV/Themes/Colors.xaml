<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base surface tones -->
    <Color x:Key="BgDeepColor">#FF06061A</Color>
    <Color x:Key="BgPanelColor">#FF0C0C22</Color>
    <Color x:Key="BgPanel2Color">#FF12122E</Color>
    <Color x:Key="BgElevatedColor">#FF181838</Color>
    <Color x:Key="BgHoverColor">#FF22224A</Color>
    <Color x:Key="BorderSoftColor">#FF1F1F44</Color>
    <Color x:Key="BorderColor">#FF2A2A55</Color>
    <Color x:Key="BorderStrongColor">#FF3A3A6C</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#FFE8E8F0</Color>
    <Color x:Key="TextMutedColor">#FF8A8AAA</Color>
    <Color x:Key="TextDimColor">#FF636384</Color>

    <!-- Neon accents -->
    <Color x:Key="AccentBlueColor">#FF3FB8FF</Color>
    <Color x:Key="AccentVioletColor">#FF8B5CF6</Color>
    <Color x:Key="AccentPurpleColor">#FFA855F7</Color>
    <Color x:Key="AccentPinkColor">#FFD946EF</Color>
    <Color x:Key="AccentIndigoColor">#FF6366F1</Color>

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#FF22C55E</Color>
    <Color x:Key="WarnColor">#FFF59E0B</Color>
    <Color x:Key="ErrorColor">#FFEF4444</Color>

    <!-- Code syntax -->
    <Color x:Key="CodeKeywordColor">#FFC084FC</Color>
    <Color x:Key="CodeStringColor">#FF86EFAC</Color>
    <Color x:Key="CodeNumberColor">#FFFBBF24</Color>
    <Color x:Key="CodeCommentColor">#FF6B7280</Color>
    <Color x:Key="CodeIdentColor">#FFE0E0F8</Color>
    <Color x:Key="CodeFunctionColor">#FF60A5FA</Color>
    <Color x:Key="CodeLineNoColor">#FF50506B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}"/>
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}"/>
    <SolidColorBrush x:Key="BgPanel2Brush" Color="{StaticResource BgPanel2Color}"/>
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}"/>
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}"/>
    <SolidColorBrush x:Key="AccentVioletBrush" Color="{StaticResource AccentVioletColor}"/>
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}"/>
    <SolidColorBrush x:Key="AccentPinkBrush" Color="{StaticResource AccentPinkColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <!-- Signature neon gradient (blue -> violet -> pink) -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentVioletColor}" Offset="0.55"/>
        <GradientStop Color="{StaticResource AccentPinkColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientHorizontal" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource AccentBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentVioletColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ActiveNavGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF4338CA" Offset="0"/>
        <GradientStop Color="#FF7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="HeroGlow" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="#552B1B6E" Offset="0"/>
        <GradientStop Color="#0006061A" Offset="1"/>
    </RadialGradientBrush>

</ResourceDictionary>
